{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "164073284090758734"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "seassistdev",
      "maxLength": 15,
      "metadata": {
        "description": "Base name used for Azure resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "backendImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/k8se/quickstart:latest",
      "metadata": {
        "description": "Container image for the SE Assist backend API. Use a placeholder for the first deployment."
      }
    },
    "postgresAdminObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID for the Entra admin assigned to PostgreSQL."
      }
    },
    "postgresAdminPrincipalName": {
      "type": "string",
      "metadata": {
        "description": "User principal name for the Entra PostgreSQL admin."
      }
    },
    "postgresAdminLogin": {
      "type": "string",
      "defaultValue": "seassistadmin",
      "metadata": {
        "description": "Administrator login name for PostgreSQL password authentication."
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator password for PostgreSQL password authentication. Provide a strong value at deploy time."
      }
    },
    "postgresDatabaseName": {
      "type": "string",
      "defaultValue": "se_assist",
      "metadata": {
        "description": "Name of the application database created on the PostgreSQL server."
      }
    },
    "postgresServerName": {
      "type": "string",
      "defaultValue": "seassistdev-pg-app",
      "metadata": {
        "description": "Name of the PostgreSQL flexible server. Defaults to the existing app server so IaC and local config target the same instance."
      }
    },
    "deployerPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID for the deployment principal that should receive ACR Push role."
      }
    },
    "foundryModelName": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Model name for the Foundry chat deployment."
      }
    },
    "foundryModelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Model version for the Foundry chat deployment."
      }
    },
    "foundryModelCapacity": {
      "type": "int",
      "defaultValue": 50,
      "metadata": {
        "description": "Deployment SKU capacity for the Foundry chat deployment, in thousands of TPM."
      }
    },
    "deployContainerApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "When false, skips the Container App and its role assignments. Use false for the initial infra deployment when no image exists yet."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id, parameters('name'))]",
    "containerAppName": "[format('{0}-api-{1}', parameters('name'), variables('suffix'))]",
    "environmentName": "[format('{0}-env-{1}', parameters('name'), variables('suffix'))]",
    "postgresName": "[parameters('postgresServerName')]",
    "keyVaultName": "[take(format('{0}kv{1}', parameters('name'), variables('suffix')), 24)]",
    "storageName": "[take(toLower(format('{0}st{1}', parameters('name'), variables('suffix'))), 24)]",
    "appInsightsName": "[format('{0}-appi-{1}', parameters('name'), variables('suffix'))]",
    "logAnalyticsName": "[format('{0}-logs-{1}', parameters('name'), variables('suffix'))]",
    "containerRegistryName": "[take(toLower(format('{0}acr{1}', parameters('name'), variables('suffix'))), 50)]",
    "foundryAccountName": "[format('{0}-ai-{1}', parameters('name'), variables('suffix'))]",
    "foundryDeploymentName": "[format('meeting-prep-{0}', replace(parameters('foundryModelName'), '.', '-'))]",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "cognitiveServicesUserRoleId": "a97b65f3-24c7-4388-baec-2e87135dc908",
    "acrPushRoleId": "8311e382-0749-4cb8-b61a-304f252e45ec",
    "pullIdentityName": "[format('{0}-pull-{1}', parameters('name'), variables('suffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[tenant().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enablePurgeProtection": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-11-01-preview",
      "name": "[variables('containerRegistryName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('foundryAccountName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "customSubDomainName": "[variables('foundryAccountName')]",
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('foundryAccountName'), variables('foundryDeploymentName'))]",
      "sku": {
        "name": "Standard",
        "capacity": "[parameters('foundryModelCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('foundryModelName')]",
          "version": "[parameters('foundryModelVersion')]"
        },
        "versionUpgradeOption": "OnceCurrentVersionExpired"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('postgresName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('postgresAdminLogin')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "authConfig": {
          "activeDirectoryAuth": "Enabled",
          "passwordAuth": "Enabled",
          "tenantId": "[tenant().tenantId]"
        },
        "dataEncryption": {
          "type": "SystemManaged"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/configurations",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'azure.extensions')]",
      "properties": {
        "value": "pgcrypto",
        "source": "user-override"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), parameters('postgresDatabaseName'))]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/configurations', variables('postgresName'), 'azure.extensions')]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/administrators",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), parameters('postgresAdminObjectId'))]",
      "properties": {
        "principalName": "[parameters('postgresAdminPrincipalName')]",
        "principalType": "User",
        "tenantId": "[tenant().tenantId]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('postgresName'), parameters('postgresDatabaseName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'AllowAllAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/administrators', variables('postgresName'), parameters('postgresAdminObjectId'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('pullIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')), variables('acrPullRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]"
      ]
    },
    {
      "condition": "[parameters('deployContainerApp')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 7071,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "database-url",
              "value": "[format('postgresql://{0}:{1}@{2}:5432/{3}?sslmode=require', parameters('postgresAdminLogin'), uriComponent(parameters('postgresAdminPassword')), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName, parameters('postgresDatabaseName'))]"
            }
          ],
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), '2023-11-01-preview').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('backendImage')]",
              "env": [
                {
                  "name": "PORT",
                  "value": "7071"
                },
                {
                  "name": "AUTH_MODE",
                  "value": "fake"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "DATABASE_URL",
                  "secretRef": "database-url"
                },
                {
                  "name": "FOUNDRY_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), '2024-10-01').endpoint]"
                },
                {
                  "name": "FOUNDRY_DEPLOYMENT",
                  "value": "[variables('foundryDeploymentName')]"
                },
                {
                  "name": "FOUNDRY_API_VERSION",
                  "value": "2024-10-21"
                },
                {
                  "name": "RUN_MIGRATIONS_ON_STARTUP",
                  "value": "0"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('foundryAccountName'), variables('foundryDeploymentName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]"
      ]
    },
    {
      "condition": "[parameters('deployContainerApp')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), variables('containerAppName'), variables('cognitiveServicesUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('containerAppName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('deployerPrincipalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), parameters('deployerPrincipalId'), variables('acrPushRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPushRoleId'))]",
        "principalId": "[parameters('deployerPrincipalId')]",
        "principalType": "User"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName'))]"
      ]
    }
  ],
  "outputs": {
    "backendUrl": {
      "type": "string",
      "value": "[if(parameters('deployContainerApp'), format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn), '')]"
    },
    "backendFqdn": {
      "type": "string",
      "value": "[if(parameters('deployContainerApp'), reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn, '')]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('containerAppName')]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "postgresName": {
      "type": "string",
      "value": "[variables('postgresName')]"
    },
    "postgresDatabaseName": {
      "type": "string",
      "value": "[parameters('postgresDatabaseName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "containerRegistryName": {
      "type": "string",
      "value": "[variables('containerRegistryName')]"
    },
    "containerRegistryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('containerRegistryName')), '2023-11-01-preview').loginServer]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), '2024-10-01').endpoint]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[variables('foundryAccountName')]"
    },
    "foundryDeploymentName": {
      "type": "string",
      "value": "[variables('foundryDeploymentName')]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
    },
    "deployContainerApp": {
      "type": "bool",
      "value": "[parameters('deployContainerApp')]"
    }
  }
}