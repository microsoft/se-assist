# SE Assist — optional configuration template.
#
# You do NOT need any of these to run the app. Core features (in-app Microsoft 365
# sign-in, MSX/Dynamics, Copilot AI, Seismic, GitHub) work out of the box with sensible
# defaults. Copy this file to `.env` (repo root) or `desktop/.env` and set only the
# values you want to override. Both files are gitignored — never commit real secrets.

# ── Identity ────────────────────────────────────────────────────────────────────
# Display name used to find the milestones you own in MSX. Normally pulled from your
# Microsoft 365 sign-in and cached locally; set only as an offline fallback.
#SE_ASSIST_USER_NAME=First Last

# ── Ingestion sources (personal enrichment) ─────────────────────────────────────
# Teams source: auto (default) | cli | none
#SE_ASSIST_TEAMS_SOURCE=auto
# Email source: auto (default) | workiq | none
#SE_ASSIST_EMAIL_SOURCE=auto
# Optional personal research-dossier vault; no vault is bundled with the source or installer.
# Development checks repo-root vault when present; set this to use another local directory.
#SE_ASSIST_VAULT_DIR=C:\path\to\vault

# ── Azure AI Foundry (optional AI provider) ─────────────────────────────────────
# By default the app uses your Copilot subscription models. To use Azure AI Foundry
# instead, disconnect GitHub Copilot and set an endpoint + deployment and EITHER an
# API key OR a complete service principal. A connected-but-failing Copilot session
# never silently switches to Foundry.
#AI_FOUNDRY_ENDPOINT=https://<your-foundry>.services.ai.azure.com
#AI_FOUNDRY_DEPLOYMENT=gpt-5.4
#FOUNDRY_API_VERSION=2024-10-21
# Auth option A — API key:
#FOUNDRY_API_KEY=
# Auth option B — service principal (Entra app registration):
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=

# ── Advanced client-ID overrides (rarely needed) ────────────────────────────────
# Entra public-client app ID for in-app M365 sign-in (defaults to a built-in ID).
#SEASSIST_ENTRA_CLIENT_ID=
# Tenant used for Foundry SP auth when AZURE_TENANT_ID is unset.
#ENTRA_TENANT_ID=
# GitHub OAuth app for the GitHub integration.
#SEASSIST_GH_CLIENT_ID=
#SEASSIST_GH_SCOPE=read:user
# Copilot provider tuning.
#COPILOT_INTEGRATION_ID=vscode-chat
#COPILOT_MODEL=
# Optional utility-role model for bounded extraction/classification. If unset,
# utility tasks use the primary model above.
#COPILOT_UTILITY_MODEL=
# Default is high. xhigh remains an explicit opt-in.
#COPILOT_REASONING_EFFORT=high
# Shared admission scheduler across Copilot, Foundry, and desktop-launched ingestion AI.
#COPILOT_MAX_CONCURRENT=1
#COPILOT_MIN_REQUEST_INTERVAL_MS=750
#COPILOT_MAX_AUTO_COOLDOWN_MS=30000
#COPILOT_COOLDOWN_RETRIES=1
#COPILOT_CHAT_TIMEOUT_MS=120000
#COPILOT_RESPONSES_REASONING_HEADROOM=25000
# Package feed used to resolve the WorkIQ binary when the local dependency is absent.
#WORKIQ_NPM_REGISTRY=https://packagefeedproxy.microsoft.io/npm
# Seismic content integration overrides.
#SEISMIC_CLIENT_ID=
#SEISMIC_TENANT=microsoft
#SEISMIC_DOCCENTER_URL=
#SEISMIC_SEARCH_HOST=
