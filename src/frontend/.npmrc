# The public npm registry (registry.npmjs.org) is blocked by IT network protection on
# Microsoft locked-down laptops. Route installs through the corp package-feed proxy — an
# org-network mirror of the public npm registry — so `npm ci` (run by the desktop build's
# build:frontend step) works on any machine on the corp network.
#
# npm's default replace-registry-host=npmjs rewrites lockfile URLs whose host is
# registry.npmjs.org to this registry, so the pinned lockfile still installs via the proxy.
#
# Off the corp network? Override at install time, e.g.:
#   $env:NPM_CONFIG_REGISTRY = 'https://registry.npmjs.org'; npm ci
registry=https://packagefeedproxy.microsoft.io/npm
